# Copy to .env before running docker compose or scripts/local-scan.sh.
# Never commit the real .env.

# ── Anthropic ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────
# Classic PAT. "repo" scope for private repos, "public_repo" for public only.
# The remediation PR agent additionally needs write access to the target.
GITHUB_TOKEN=
GITHUB_ORG=

# ── DefectDojo ───────────────────────────────────────────────────
# Local stack default. After first boot, log in at http://localhost:8080
# with the admin credentials below, then copy your API v2 key here.
DEFECTDOJO_URL=http://localhost:8080
DEFECTDOJO_API_KEY=

DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=admin
DD_DATABASE_PASSWORD=defectdojo

# Generate real values for anything exposed beyond localhost:
#   openssl rand -base64 32
DD_SECRET_KEY=changeme-local-only
DD_CREDENTIAL_AES_256_KEY=changeme-local-only

# ── ToolVault backend ────────────────────────────────────────────
JWT_SECRET=local-dev-secret
