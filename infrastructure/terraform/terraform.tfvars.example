# Copy to terraform.tfvars and adjust.

aws_region    = "us-east-2"
environment   = "dev"
instance_type = "t3.medium"

# Existing EC2 key pair name. Leave empty to use SSM Session Manager instead.
key_name = ""

# Your own IP, so SSH is not open to the internet.
# Find it with: curl -s https://checkip.amazonaws.com
# allowed_ssh_cidr = "203.0.113.4/32"

# Restrict who can reach the UI. Defaults to open.
# allowed_web_cidr = "203.0.113.4/32"

repository_url   = "https://github.com/maustin44/toolvault.git"
root_volume_size = 30
