# Remote state.
#
# Local state is fine for a single operator, but it lives on one machine
# and offers no locking. To use S3 instead:
#
#   1. Create the bucket and lock table once, by hand or in a separate
#      bootstrap configuration:
#
#      aws s3api create-bucket --bucket toolvault-tfstate-<unique> \
#          --region us-east-2 \
#          --create-bucket-configuration LocationConstraint=us-east-2
#      aws s3api put-bucket-versioning --bucket toolvault-tfstate-<unique> \
#          --versioning-configuration Status=Enabled
#      aws dynamodb create-table --table-name toolvault-tfstate-lock \
#          --attribute-definitions AttributeName=LockID,AttributeType=S \
#          --key-schema AttributeName=LockID,KeyType=HASH \
#          --billing-mode PAY_PER_REQUEST --region us-east-2
#
#   2. Rename this file to backend.tf and run: terraform init -migrate-state

terraform {
  backend "s3" {
    bucket         = "toolvault-tfstate-<unique>"
    key            = "toolvault/terraform.tfstate"
    region         = "us-east-2"
    dynamodb_table = "toolvault-tfstate-lock"
    encrypt        = true
  }
}
